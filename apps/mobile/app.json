{
  "expo": {
    "name": "Bilcode Waste",
    "slug": "bilcode-waste-assessment",
    "owner": "yarrrrr15",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "bilcodewaste",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.akhyar.bilcodewaste",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#047857"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto sampah untuk laporan Anda.",
          "cameraPermission": "Ambil foto sampah untuk laporan Anda.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gunakan lokasi saat ini untuk menunjukkan posisi sampah pada laporan."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/brand/splash-icon-dark.png",
            "backgroundColor": "#09090B"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a90171f1-e0b9-419e-82f0-4cfc64340b84"
      }
    }
  }
}

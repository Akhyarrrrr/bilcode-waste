# Database (docker compose up -d postgres)
DATABASE_URL=postgresql://bilcode:bilcode@localhost:5433/bilcode
DIRECT_URL=postgresql://bilcode:bilcode@localhost:5433/bilcode

# Server
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters

# Photo storage: "local" (folder on disk) or "vercel-blob" (requires BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../.local/uploads
BLOB_READ_WRITE_TOKEN=

# Classification service; use the same key when starting ml/inference
ML_URL=http://localhost:8000
ML_API_KEY=replace-with-a-random-internal-key

# Demo accounts created by `npm run db:seed` (passwords: at least 12 characters)
SEED_ADMIN_EMAIL=admin@bilcode-waste.test
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@bilcode-waste.test
SEED_USER_PASSWORD=

# Shared reviewer accounts that cannot change password, email, role or status
DEMO_LOCKED_EMAILS=admin@bilcode-waste.test,user@bilcode-waste.test

{
  "name": "@bilcode/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc --noEmit && tsup",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "docs:openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@bilcode/contracts": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sinclair/typebox": "^0.34.0",
    "@vercel/blob": "^2.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}

{
  "name": "bilcode-waste",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "postinstall": "npm run build -w @bilcode/contracts && npm run db:generate -w @bilcode/api",
    "dev": "npm run dev -w @bilcode/web",
    "dev:api": "npm run dev -w @bilcode/api",
    "dev:mobile": "npm run start -w @bilcode/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:openapi": "npm run docs:openapi -w @bilcode/api",
    "db:migrate": "npm run db:migrate -w @bilcode/api",
    "db:seed": "npm run db:seed -w @bilcode/api",
    "db:test": "node scripts/setup-test-db.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.0"
  }
}
